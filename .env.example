# Copy to .env and fill in. This file stays on the server; keys never reach the browser.
PORT=8787

# Keys YOU issue to hospitals / telemedicine clients (comma separated). They send it as the x-api-key header.
# Leave empty only for local testing (API is then open).
CLIENT_API_KEYS=

# --- AI (pick one, or leave both empty for rule-based only) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Local, free, runs on your own machine:
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision
# Let the bundled web UI use the server's AI key via /v1/ai/parse and /v1/ai/review (fixed tasks only, same-origin, rate-limited per IP)
UI_AI_PROXY=true
UI_AI_LIMIT_PER_HOUR=30

# --- Drug data ---
# Indian brand → composition CSVs, comma separated. Seed list ships in data/. Add e.g. the Kaggle A-Z dataset file here.
BRANDS_CSV=data/brands-in.csv
# Optional free key from https://open.fda.gov/apis/authentication/ (higher rate limit)
OPENFDA_API_KEY=
# Optional paid/custom source (e.g. a DrugBank proxy). Must return {"matched","ingredients":[{"name","strength_mg"}],"max_daily_mg":{}}
CUSTOM_SOURCE_URL=
CUSTOM_SOURCE_HEADER=Authorization
CUSTOM_SOURCE_KEY=
